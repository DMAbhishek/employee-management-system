# ============================================================
# .env.example  –  Employee Management System
# ============================================================
# Copy this file to .env (backend) and fill in your values.
# NEVER commit a file with real credentials to GitHub.
# ============================================================

# ── MySQL ───────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/emp_management_db?useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET=YourSuperSecretKeyMinimum32Characters!
JWT_EXPIRATION=86400000

# ── Frontend (React + Vite) ──────────────────────────────────
# Vite requires the VITE_ prefix (not REACT_APP_)
VITE_API_BASE_URL=http://localhost:8080/api

